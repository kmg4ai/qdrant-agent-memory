# Copy → .env and fill in your values (do NOT commit .env!)
# Qdrant — cloud address or local (e.g. http://localhost:6333)
QDRANT_URL=https://your-qdrant-cloud-url.example.com
# API key from the Qdrant Cloud panel (or empty for local, no auth)
QDRANT_API_KEY=your-api-key-here
# Collection name — add -v2 at the end for vectors with time features (e.g. my-memory-v2)
COLLECTION_NAME=my-memory-v2

# ── Models ────────────────────────────────────────────────────────────
# Embedding model (index time). Must write the SAME vectors as your existing
# points — running it against a collection built with a different model returns
# nonsense with no error. 384-dim models are a drop-in for a -v2 collection;
# anything larger needs a NEW collection. See README → "Switching models".
# QDRANT_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Reranker (query time, optional but recommended). A cross-encoder re-scores the
# top candidates; it stores nothing, so switching it costs no reindex.
#   QDRANT_RERANK=0                     turn reranking off
#   QDRANT_RERANK_CANDIDATES=50         how many candidates to re-score
# QDRANT_RERANK_MODEL=jinaai/jina-reranker-v1-turbo-en

# Where model weights are cached. Set this OFF /tmp if your /tmp is tmpfs —
# weights there live in RAM and vanish on reboot.
# FASTEMBED_CACHE_PATH=/root/.cache/fastembed

# ── Rules ingest (`ingest.py infrastructure`) ─────────────────────────
# WITHOUT these two, `ingest.py infrastructure` stores NOTHING and prints
# instructions. It reads your coding rules so your agent can recall them.
# QDRANT_RULES_DIR=/path/to/a/directory/of/*.md
# QDRANT_AGENTS_FILES=/path/to/AGENTS.md:/path/to/AGENTS(PL).md
#                     ^ several files, separated by COLONS

# ── Optional — override default source paths for the other ingest sources ──
# QDRANT_VPS_DOC=/path/to/your/vps-doc.md
# QDRANT_CHANGELOG=/path/to/your/CHANGELOG.md
# QDRANT_WWW_ROOT=/var/www
# QDRANT_NGINX_DIR=/etc/nginx/sites-enabled
# QDRANT_SYSTEMD_DIR=/etc/systemd/system
